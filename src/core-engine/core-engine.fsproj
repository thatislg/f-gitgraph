<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Nhân tính toán F# "f-gitgraph-core" — độc lập hoàn toàn với hệ sinh thái Node.js
    của VS Code Extension. Tham khảo tài liệu thiết kế:
    docs/02_design/001_windows/01_Project_Structure_And_NativeAOT.md
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Tên file thực thi đầu ra: f-gitgraph-core.exe -->
    <AssemblyName>f-gitgraph-core</AssemblyName>
    <RootNamespace>NeoGitCore</RootNamespace>
    <Nullable>enable</Nullable>
    <!-- Cần unsafe để tạo ReadOnlySpan trực tiếp từ Memory-Mapped View (Zero-Allocation). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!--
    Cấu hình biên dịch Native AOT (Ahead-Of-Time):
    Chỉ kích hoạt khi có RuntimeIdentifier hoặc cờ PublishAot=true (khi chạy dotnet publish).
    Khi chạy dotnet test hoặc dotnet build thông thường, core-engine biên dịch dạng thư viện
    chuẩn để chạy được trên mọi môi trường thử nghiệm (Windows, Linux, macOS) mà không gặp
    lỗi assembly loader.
  -->
  <PropertyGroup Condition="'$(PublishAot)' == 'true' or '$(RuntimeIdentifier)' != ''">
    <PublishAot>true</PublishAot>
    <PublishTrimmed>true</PublishTrimmed>
    <InvariantGlobalization>true</InvariantGlobalization>
    <StripSymbols>true</StripSymbols>
    <OptimizationPreference>Size</OptimizationPreference>
    <IlcOptimizationPreference>Size</IlcOptimizationPreference>
    <IlcGenerateStackTraceData>false</IlcGenerateStackTraceData>
    <IlcFoldIdenticalMethodBodies>true</IlcFoldIdenticalMethodBodies>
  </PropertyGroup>

  <!-- Thứ tự biên dịch F# phải tuân theo chiều phụ thuộc: Domain -> Storage -> Graph -> Transport -> Benchmark -> Program -->
  <ItemGroup>
    <Compile Include="Domain/Domain.fs" />
    <Compile Include="Domain/CoreEntities.fs" />
    <Compile Include="Domain/InFlightState.fs" />
    <Compile Include="Domain/GitError.fs" />
    <Compile Include="Storage/Utf8.fs" />
    <Compile Include="Storage/CommitGraph.fs" />
    <Compile Include="Storage/LibGit2.fs" />
    <Compile Include="Storage/Storage.fs" />
    <Compile Include="Graph/Graph.fs" />
    <Compile Include="Transport/Transport.fs" />
    <Compile Include="Benchmark.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <!-- Cung cấp thư viện C gốc LibGit2 (git2-*.dll) cho chế độ Native AOT. -->
  <ItemGroup>
    <PackageReference Include="LibGit2Sharp.NativeBinaries" Version="2.0.324" />
  </ItemGroup>

</Project>
