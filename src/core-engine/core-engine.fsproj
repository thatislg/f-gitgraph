<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Nhân tính toán F# "f-gitgraph-core" — độc lập hoàn toàn với hệ sinh thái Node.js
    của VS Code Extension. Tham khảo tài liệu thiết kế:
    docs/02_design/001_windows/01_Project_Structure_And_NativeAOT.md
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Tên file thực thi đầu ra: f-gitgraph-core.exe -->
    <AssemblyName>f-gitgraph-core</AssemblyName>
    <RootNamespace>NeoGitCore</RootNamespace>
    <Nullable>enable</Nullable>
    <!-- Cần unsafe để tạo ReadOnlySpan trực tiếp từ Memory-Mapped View (Zero-Allocation). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!--
    Cấu hình biên dịch Native AOT (Ahead-Of-Time) cho Windows 64-bit:
    - PublishAot: biên dịch trước toàn bộ mã máy, loại bỏ bytecode trung gian (CIL) và JIT.
    - RuntimeIdentifier / SelfContained: nhắm win-x64, tự chứa toàn bộ runtime tối thiểu.
    - PublishTrimmed: kích hoạt cắt tỉa mã nguồn tích cực (Aggressive Trimming).
    - InvariantGlobalization: cắt bỏ bảng tra cứu văn hóa quốc gia (tiết kiệm 3–5MB).
    - StripSymbols: lược bỏ biểu tượng gỡ lỗi (PDB) khỏi nhị phân phát hành.
    - IlcOptimizationPreference=Size: tối ưu hóa kích thước để đạt mục tiêu 6–9MB.
      LTO (Link Time Optimization) do MSVC Linker thực hiện mặc định ở chế độ Release.
  -->
  <PropertyGroup>
    <PublishAot>true</PublishAot>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishTrimmed>true</PublishTrimmed>
    <InvariantGlobalization>true</InvariantGlobalization>
    <StripSymbols>true</StripSymbols>
    <OptimizationPreference>Size</OptimizationPreference>
    <IlcOptimizationPreference>Size</IlcOptimizationPreference>
    <!-- Không phát sinh dữ liệu stack trace để giảm kích thước nhị phân. -->
    <IlcGenerateStackTraceData>false</IlcGenerateStackTraceData>
    <IlcFoldIdenticalMethodBodies>true</IlcFoldIdenticalMethodBodies>
  </PropertyGroup>

  <!-- Thứ tự biên dịch F# phải tuân theo chiều phụ thuộc: Domain -> Storage -> Graph -> Transport -> Benchmark -> Program -->
  <ItemGroup>
    <Compile Include="Domain/Domain.fs" />
    <Compile Include="Domain/CoreEntities.fs" />
    <Compile Include="Domain/InFlightState.fs" />
    <Compile Include="Domain/GitError.fs" />
    <Compile Include="Storage/Utf8.fs" />
    <Compile Include="Storage/CommitGraph.fs" />
    <Compile Include="Storage/LibGit2.fs" />
    <Compile Include="Storage/Storage.fs" />
    <Compile Include="Graph/Graph.fs" />
    <Compile Include="Transport/Transport.fs" />
    <Compile Include="Benchmark.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <!-- Cung cấp thư viện C gốc LibGit2 (git2-*.dll) cho chế độ Native AOT. -->
  <ItemGroup>
    <PackageReference Include="LibGit2Sharp.NativeBinaries" Version="2.0.324" />
  </ItemGroup>

</Project>
